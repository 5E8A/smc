{
  "name": "smc---seba-modding-community",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:screenshot": "set VITE_SCREENSHOT=true&& vite dev",
    "build": "npm run lint && npm run check-content && vite build",
    "build:screenshot": "set VITE_SCREENSHOT=true&& npm run lint && npm run check-content && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot/run.mjs",
    "screenshot:install": "playwright install chromium firefox webkit",
    "analyze": "vite build --mode analyze",
    "generate-lqip": "node scripts/generate-blurhash.mjs",
    "cms": "npm --prefix cms run dev",
    "check-content": "node scripts/check-content.mjs",
    "generate-sprites": "node scripts/generate-sprites.mjs",
    "fetch-mods": "node scripts/fetch-mod-icons.mjs",
    "lint": "oxlint src/ shared/ cms/src cms/server scripts/ vite.config.ts --type-aware --type-check",
    "lint:fix": "oxlint --fix src/ shared/ cms/src cms/server scripts/ vite.config.ts --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.47",
    "blurhash": "^2.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "nitro": "^3.0.260610-beta",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
