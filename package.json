{
  "name": "@smc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "@web",
    "@cms",
    "@shared"
  ],
  "scripts": {
    "web:dev": "npm -w @smc/web run dev",
    "web:build": "npm -w @smc/web run build",
    "web:start": "npm -w @smc/web run start",
    "web:lint": "npm -w @smc/web run lint",
    "web:typecheck": "npm -w @smc/web run typecheck",
    "cms": "npm -w @smc/cms run start",
    "cms:dev": "npm -w @smc/cms run dev",
    "cms:build": "npm -w @smc/cms run build",
    "cms:typecheck": "npm -w @smc/cms run typecheck",
    "cms:lint": "npm -w @smc/cms run lint",
    "cms:ffmpeg": "node @scripts/fetch-ffmpeg.mjs",
    "dev": "npm -w @smc/web run dev",
    "build": "npm -w @smc/web run build",
    "start": "npm -w @smc/web run start",
    "generate-lqip": "node @scripts/generate-blurhash.mjs",
    "check-content": "node @scripts/check-content.mjs",
    "sync-mods": "node @scripts/sync-mods.mjs",
    "sync-icons": "node @scripts/sync-icons.mjs",
    "lint": "npm run lint --workspaces && oxlint @scripts/ --type-aware --type-check",
    "lint:fix": "npm run lint:fix --workspaces && oxlint --fix @scripts/ --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "blurhash": "^2.0.5",
    "koffi": "^3.1.6",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.0.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "koffi@3.1.6": true
  }
}
